
[*.cs]
indent_style = space
indent_size = 2
tab_width = 2

[*]

# Microsoft .NET properties
csharp_indent_braces = false
csharp_new_line_before_open_brace = accessors,anonymous_types,control_blocks,events,indexers,local_functions,methods,object_collection_array_initializers,properties
csharp_preferred_modifier_order = private, protected, async, internal, file, new, public, abstract, virtual, sealed, override, static, extern, unsafe, volatile, readonly, required:suggestion
csharp_preserve_single_line_blocks = true
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_property = true:suggestion

# ReSharper properties
resharper_arguments_skip_single = true
resharper_blank_lines_after_block_statements = 0
resharper_blank_lines_after_start_comment = 0
resharper_blank_lines_around_accessor = 1
resharper_blank_lines_before_control_transfer_statements = 1
resharper_csharp_blank_lines_around_invocable = 0
resharper_csharp_blank_lines_around_single_line_field = 1
resharper_csharp_indent_invocation_pars = none
resharper_csharp_indent_size = 2
resharper_csharp_keep_existing_enum_arrangement = false
resharper_csharp_max_line_length = 302
resharper_csharp_remove_blank_lines_near_braces_in_code = false
resharper_csharp_space_around_alias_eq = false
resharper_csharp_wrap_after_declaration_lpar = true
resharper_csharp_wrap_arguments_style = chop_if_long
resharper_csharp_wrap_before_binary_opsign = true
resharper_csharp_wrap_parameters_style = chop_if_long
resharper_indent_inside_namespace = false
resharper_indent_preprocessor_other = do_not_change
resharper_indent_preprocessor_region = do_not_change
resharper_keep_existing_attribute_arrangement = true
resharper_max_attribute_length_for_same_line = 10000
resharper_method_or_operator_body = expression_body
resharper_parentheses_redundancy_style = remove
resharper_place_expr_method_on_single_line = true
resharper_place_field_attribute_on_same_line = if_owner_is_single_line
resharper_place_method_attribute_on_same_line = true
resharper_place_simple_embedded_statement_on_same_line = false
resharper_place_simple_initializer_on_single_line = false
resharper_space_before_new_parentheses = true
resharper_space_within_empty_braces = false
resharper_wrap_chained_binary_expressions = chop_if_long
